# Copy to .env and fill in. Never commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=
MODEL_ORCHESTRATOR=claude-sonnet-5
MODEL_ICP=claude-haiku-4-5
MODEL_RESEARCHER=claude-opus-5-5
MODEL_COPYWRITER=claude-opus-5-5
MODEL_GROUNDING=claude-haiku-4-5
# The small checks (is the objective a lead search? + the pre-run credit probe). Change as Haiku improves
MODEL_CHECKS=claude-haiku-4-5
CLAUDE_BUDGET_TOTAL_USD=6.00

# --- Apify (TEAM account token, not personal) ---
APIFY_TOKEN=
APIFY_ACTOR_ID=harvestapi/linkedin-company-search

# --- Firecrawl ---
FIRECRAWL_API_KEY=

# --- Supabase Postgres (schema lead_agent) ---
# Session pooler connection string (IPv4), from Supabase → Connect
# App role, you write this line yourself (password: .venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(32))"),
# then run scripts/create_app_role.py (reads it, never writes .env): postgresql://lead_agent_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_DSN=
SUPABASE_DB_SCHEMA=lead_agent
# Admin (postgres) DSN — LOCAL ONLY, for running migrations. Never set on Render.
SUPABASE_ADMIN_DSN=

# --- Supabase Auth (logins) — SERVER-SIDE ONLY, never sent to the browser ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used only for admin invites
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# --- App ---
# Random 32+ chars: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Public URL of the app (invite links redirect here), e.g. https://<service>.onrender.com
APP_BASE_URL=http://localhost:8000
RESEARCH_REUSE_DAYS=30
# Owner alerts (optional): your n8n webhook URL (n8n/alert-email-workflow.json) + a shared secret
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
SCRAPE_CACHE_DAYS=7
DEV_LIMITS=true
FIXTURE_MODE=false
# Optional: researchers/copywriters at once (default 1; >1 is NOT safe with CLI 2.1.280, see specs D-49)
MAX_PARALLEL_SUBAGENTS=
MAX_RUNS_PER_DAY=5
# Per person per day (members / admins)
MAX_RUNS_PER_USER_PER_DAY=2
MAX_RUNS_PER_ADMIN_PER_DAY=5
# Optional: force Secure cookies on/off (default: on when APP_BASE_URL is https)
COOKIE_SECURE=
# Optional: DEBUG | INFO | WARNING (default INFO)
LOG_LEVEL=
PORT=8000
# RENDER_EXTERNAL_URL is set automatically by Render
